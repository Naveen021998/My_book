MYSQL_DATABASE=tranning
MYSQL_ROOT_PASSWORD=root

# Shared JWT secret for authorization-service (issuer) and core-application-service (validator).
# Must be >= 32 bytes.
JWT_SECRET=dev-secret-dev-secret-dev-secret-dev-secret
JWT_ISSUER=ledger-auth
JWT_ACCESS_TTL_MINUTES=15

AUTH_DB_URL=jdbc:mysql://localhost:3306/tranning?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=root
CORE_DB_URL=jdbc:mysql://localhost:3306/tranning?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
CORE_DB_USERNAME=root
CORE_DB_PASSWORD=root
USER_DB_URL=jdbc:mysql://localhost:3306/tranning?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
USER_DB_USERNAME=root
USER_DB_PASSWORD=root
NOTIFICATION_DB_URL=jdbc:mysql://localhost:3306/tranning?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
NOTIFICATION_DB_USERNAME=root
NOTIFICATION_DB_PASSWORD=root
FILE_DB_URL=jdbc:mysql://localhost:3306/tranning?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
FILE_DB_USERNAME=root
FILE_DB_PASSWORD=root
FILES_STORAGE_DIR=/app/data/files

# gateway upstreams for host-mode dev (optional)
NOTIFICATION_UPSTREAM=host.docker.internal:8085
FILE_UPSTREAM=host.docker.internal:8086
